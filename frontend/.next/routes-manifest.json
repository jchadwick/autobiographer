{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/stories/[id]",
      "regex": "^/stories/([^/]+?)(?:/)?$",
      "routeKeys": { "nxtPid": "nxtPid" },
      "namedRegex": "^/stories/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    { "page": "/", "regex": "^/(?:/)?$", "routeKeys": {}, "namedRegex": "^/(?:/)?$" },
    {
      "page": "/stories",
      "regex": "^/stories(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/stories(?:/)?$"
    },
    {
      "page": "/stories/new",
      "regex": "^/stories/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/stories/new(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc"
  },
  "rewrites": []
}
