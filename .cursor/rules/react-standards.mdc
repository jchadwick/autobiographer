# React Component Standards

Standards for writing React components in TypeScript.

<rule>
name: react_component_standards
description: Standards for writing React components in TypeScript, focusing on type safety and modern practices
filters:
  # Match React component files
  - type: file_extension
    pattern: "\\.tsx?$"
  # Match files containing React components
  - type: content
    pattern: "React|Component|jsx"

actions:
  - type: validate
    conditions:
      - pattern: "React\\.FC"
        message: "Do not use React.FC type. Instead, define props interface and use function declaration with explicit props type."

  - type: suggest
    message: |
      Follow these standards for React components:
      
      1. Props Type Definition:
         - DO NOT use React.FC or React.FunctionComponent
         - Always define a props interface
         - Use type inference for the component return type
         
         ```tsx
         // ❌ Don't do this:
         const MyComponent: React.FC<MyProps> = ({ prop1, prop2 }) => {
           return <div>{prop1}</div>;
         };
         
         // ✅ Do this instead:
         interface MyComponentProps {
           prop1: string;
           prop2?: number;
         }
         
         function MyComponent({ prop1, prop2 }: MyComponentProps) {
           return <div>{prop1}</div>;
         }
         ```
         
      2. Benefits of avoiding React.FC:
         - Better type inference for default props
         - No implicit children prop when not needed
         - More explicit about component structure
         - Follows official TypeScript-React documentation recommendations
         
      3. Component Declaration:
         - Use arrow functions for components (not function declarations)
         - Name components using PascalCase
         - Keep components pure when possible
         - Split complex components into smaller, focused ones

      4. Smart/Dumb components
         - Limit logic and orchestration to higher-level "Smart" components
         - Implement view logic in lower-level "dumb" components

examples:
  - input: |
      // Component with React.FC
      const UserProfile: React.FC<UserProfileProps> = ({ name, email }) => {
        return (
          <div>
            <h2>{name}</h2>
            <p>{email}</p>
          </div>
        );
      };
    output: |
      // Properly typed component
      interface UserProfileProps {
        name: string;
        email: string;
      }
      
      function UserProfile({ name, email }: UserProfileProps) {
        return (
          <div>
            <h2>{name}</h2>
            <p>{email}</p>
          </div>
        );
      }

  - input: |
      // Generic component with React.FC
      const List: React.FC<{ items: T[] }> = ({ items }) => {
        return (
          <ul>
            {items.map((item) => (
              <li key={item.id}>{item.name}</li>
            ))}
          </ul>
        );
      };
    output: |
      // Properly typed generic component
      interface ListProps<T> {
        items: T[];
      }
      
      function List<T extends { id: string | number; name: string }>({ 
        items 
      }: ListProps<T>) {
        return (
          <ul>
            {items.map((item) => (
              <li key={item.id}>{item.name}</li>
            ))}
          </ul>
        );
      }

metadata:
  priority: high
  version: 1.0
  tags:
    - react
    - typescript
    - components
</rule>
